<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MusicalScales.Views"
        x:Class="MusicalScales.Views.MainWindow"
        Title="Musical Scales — Guitar Fretboard"
        Width="1360" Height="860"
        MinWidth="900" MinHeight="640"
        Background="#12141A"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.bar">
      <Setter Property="Background" Value="#1A1E25"/>
      <Setter Property="BorderBrush" Value="#262C36"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style Selector="StackPanel.field">
      <Setter Property="Margin" Value="0,0,16,8"/>
    </Style>
    <Style Selector="StackPanel.field > TextBlock">
      <Setter Property="Foreground" Value="#8A93A3"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#C7CEDA"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="24"/>
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#8A93A3"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#E7EAF0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#8A93A3"/>
      <Setter Property="Padding" Value="20,8"/>
      <Setter Property="MinHeight" Value="42"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#F2F5FA"/>
    </Style>
  </Window.Styles>

  <TabControl x:Name="Tabs" Padding="0" Background="#12141A">

    <!-- ============================ SCALES ============================ -->
    <TabItem Header="Scales">
      <DockPanel>

        <Border Classes="bar" DockPanel.Dock="Top" BorderThickness="0,1,0,1">
          <WrapPanel Orientation="Horizontal">

            <StackPanel Classes="field">
              <TextBlock Text="ROOT"/>
              <ComboBox x:Name="RootBox" Width="86"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="FAMILY"/>
              <ComboBox x:Name="CategoryBox" Width="160"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="SCALE"/>
              <ComboBox x:Name="ScaleBox" Width="220"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="TUNING"/>
              <ComboBox x:Name="TuningBox" Width="268"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock x:Name="FretCaption" Text="FRETS"/>
              <Slider x:Name="FretSlider" Width="150" Minimum="5" Maximum="24"
                      TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,-4,0,0"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="LABELS"/>
              <ComboBox x:Name="LabelBox" Width="132"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="COLOURS"/>
              <ComboBox x:Name="ColorBox" Width="150"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="ACCIDENTALS"/>
              <ComboBox x:Name="AccidentalBox" Width="104"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="TONE"/>
              <ComboBox x:Name="ToneBox" Width="112"/>
            </StackPanel>

            <StackPanel Classes="field" Margin="4,0,16,8">
              <TextBlock Text="OPTIONS"/>
              <UniformGrid Columns="2">
                <CheckBox x:Name="AllNotesBox" Content="All notes" Margin="0,0,14,0"/>
                <CheckBox x:Name="SoundBox" Content="Sound" IsChecked="True"/>
                <CheckBox x:Name="LeftHandedBox" Content="Left-handed" Margin="0,0,14,0"/>
                <CheckBox x:Name="FlipBox" Content="Flip strings"/>
              </UniformGrid>
            </StackPanel>

          </WrapPanel>
        </Border>

        <Border Classes="bar" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0">
          <StackPanel Spacing="10">

            <StackPanel Orientation="Horizontal" Spacing="26">
              <TextBlock x:Name="TitleText" Text="—" FontSize="19" FontWeight="Bold"
                         Foreground="#F2F5FA" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="FORMULA" VerticalAlignment="Center"/>
                <TextBlock x:Name="FormulaText" Classes="value" FontFamily="Consolas,Menlo,monospace"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="STEPS" VerticalAlignment="Center"/>
                <TextBlock x:Name="StepsText" Classes="value" FontFamily="Consolas,Menlo,monospace"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="caption" Text="NOTES" VerticalAlignment="Center" Width="62"/>
              <WrapPanel x:Name="NotesPanel" Orientation="Horizontal"/>
            </StackPanel>

            <StackPanel x:Name="ChordsRow" Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="caption" Text="CHORDS" VerticalAlignment="Center" Width="62"/>
              <WrapPanel x:Name="ChordsPanel" Orientation="Horizontal"/>
            </StackPanel>

            <TextBlock x:Name="HintText" Classes="caption"
                       Text="Click any note on the fretboard to hear it."/>
          </StackPanel>
        </Border>

        <views:FretboardView x:Name="Board" Margin="10"/>
      </DockPanel>
    </TabItem>

    <!-- ============================ CHORDS ============================ -->
    <TabItem Header="Chord shapes">
      <DockPanel>

        <Border Classes="bar" DockPanel.Dock="Top" BorderThickness="0,1,0,1">
          <WrapPanel Orientation="Horizontal">

            <StackPanel Classes="field">
              <TextBlock Text="ROOT"/>
              <ComboBox x:Name="ChordRootBox" Width="86"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="CHORD"/>
              <ComboBox x:Name="ChordTypeBox" Width="200"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="TONE"/>
              <ComboBox x:Name="ChordToneBox" Width="112"/>
            </StackPanel>

            <StackPanel Classes="field" VerticalAlignment="Bottom">
              <TextBlock Text="TUNING"/>
              <TextBlock x:Name="ChordTuningText" Classes="value" Margin="2,4,0,0"/>
            </StackPanel>

          </WrapPanel>
        </Border>

        <Border Classes="bar" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="26">
              <TextBlock x:Name="ChordTitleText" Text="—" FontSize="19" FontWeight="Bold"
                         Foreground="#F2F5FA" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="FORMULA" VerticalAlignment="Center"/>
                <TextBlock x:Name="ChordFormulaText" Classes="value"
                           FontFamily="Consolas,Menlo,monospace"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="caption" Text="NOTES" VerticalAlignment="Center" Width="62"/>
              <WrapPanel x:Name="ChordNotesPanel" Orientation="Horizontal"/>
            </StackPanel>

            <StackPanel x:Name="ChordAliasRow" Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="caption" Text="SAME AS" VerticalAlignment="Center" Width="62"/>
              <TextBlock x:Name="ChordAliasText" Classes="value" Foreground="#E0A93A"
                         VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="ChordHintText" Classes="caption"
                       Text="Click a shape to strum it."/>
          </StackPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <WrapPanel x:Name="ChordShapesPanel" Orientation="Horizontal" Margin="14"/>
        </ScrollViewer>
      </DockPanel>
    </TabItem>

    <!-- ========================= PROGRESSIONS ========================= -->
    <TabItem Header="Progressions">
      <DockPanel>

        <Border Classes="bar" DockPanel.Dock="Top" BorderThickness="0,1,0,1">
          <WrapPanel Orientation="Horizontal">

            <StackPanel Classes="field">
              <TextBlock Text="KEY"/>
              <ComboBox x:Name="KeyRootBox" Width="86"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="QUALITY"/>
              <ComboBox x:Name="KeyQualityBox" Width="110"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="PROGRESSION"/>
              <ComboBox x:Name="ProgressionBox" Width="330"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Text="CHORDS"/>
              <ComboBox x:Name="ProgressionVoicingBox" Width="120"/>
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock x:Name="TempoCaption" Text="TEMPO"/>
              <Slider x:Name="TempoSlider" Width="150" Minimum="50" Maximum="180"
                      TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,-4,0,0"/>
            </StackPanel>

            <StackPanel Classes="field" VerticalAlignment="Bottom">
              <TextBlock Text=" "/>
              <Button x:Name="PlayProgressionButton" Content="▶  Play progression"
                      Padding="14,6" Margin="0,2,0,0"/>
            </StackPanel>

          </WrapPanel>
        </Border>

        <Border Classes="bar" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="26">
              <TextBlock x:Name="ProgressionTitleText" Text="—" FontSize="19"
                         FontWeight="Bold" Foreground="#F2F5FA" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="SEQUENCE" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProgressionSequenceText" Classes="value"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="caption" Text="IN KEY" VerticalAlignment="Center" Width="62"/>
              <WrapPanel x:Name="KeyChordsPanel" Orientation="Horizontal"/>
            </StackPanel>

            <TextBlock x:Name="ProgressionHintText" Classes="caption"
                       Text="Click a chord to strum it, or play the whole progression."/>
          </StackPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <WrapPanel x:Name="ProgressionPanel" Orientation="Horizontal" Margin="14"/>
        </ScrollViewer>
      </DockPanel>
    </TabItem>

  </TabControl>
</Window>

